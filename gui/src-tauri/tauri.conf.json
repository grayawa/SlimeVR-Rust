{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlimeVR",
  "version": "0.1.0",
  "identifier": "dev.slimevr.SlimeVR",
  "build": {
    "beforeDevCommand": "pnpm web:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SlimeVR",
        "width": 1289,
        "height": 709,
        "minWidth": 393,
        "minHeight": 667,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws: wss: http://localhost:* http://127.0.0.1:* https:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "SlimeVR full-body tracking interface",
    "icon": [
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/69-slimevr-devices.rules": "69-slimevr-devices.rules",
      "../../LICENSE-MIT": "LICENSE-MIT",
      "../../LICENSE-APACHE": "LICENSE-APACHE",
      "resources/drivers/": "drivers/",
      "resources/bindings/": "bindings/"
    }
  }
}
